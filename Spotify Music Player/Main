7. Complete Flow

1. Add songs to MusicLibrary.
2. Create a playlist and add songs.
3. Load the playlist into MusicPlayer.
4. Set currentIndex = 0 to select the first song.
5. play() starts or resumes playback.
6. pause() changes the state to PAUSED.
7. next() and previous() update the song index.
8. Shuffle selects a random next song.
9. Repeat allows playback to restart after the last song.
8. Complete Runnable Java Code


Single file: Main.java

import java.util.*; // Collections and Random

// Represents a single song
class Song {

    int id; // Unique song ID
    String title; // Song name
    String artist; // Artist name
    int duration; // Duration in seconds

    // Initialize song details
    Song(int id, String title, String artist, int duration) {
        this.id = id; // Store ID
        this.title = title; // Store title
        this.artist = artist; // Store artist
        this.duration = duration; // Store duration
    }
}

// Represents a playlist containing songs
class Playlist {

    String name; // Playlist name

    // Songs are stored in insertion order
    List<Song> songs = new ArrayList<>();

    // Create a new playlist
    Playlist(String name) {
        this.name = name; // Store playlist name
    }

    // Add a song to playlist
    void addSong(Song song) {
        if (song != null) { // Ignore invalid song
            songs.add(song); // Add to playlist
        }
    }

    // Remove a song from playlist
    void removeSong(Song song) {
        songs.remove(song); // Remove first matching song
    }
}

// Stores all available songs
class MusicLibrary {

    // Maintain song catalog
    List<Song> songs = new ArrayList<>();

    // Add song to library
    void addSong(Song song) {
        if (song != null) { // Validate song
            songs.add(song); // Store song
        }
    }

    // Search songs by title
    List<Song> search(String title) {

        // Store matching songs
        List<Song> result = new ArrayList<>();

        // Handle invalid search input
        if (title == null) return result;

        // Check each song in library
        for (Song song : songs) {

            // Case-insensitive partial title matching
            if (song.title.toLowerCase()
                    .contains(title.toLowerCase())) {

                result.add(song); // Save matching song
            }
        }

        return result; // Return search results
    }
}

// Playback states
enum PlayerState {
    PLAYING, PAUSED, STOPPED
}

// Handles playback operations
class MusicPlayer {

    Playlist playlist; // Currently selected playlist
    int currentIndex = 0; // Current song position

    // Initially nothing is playing
    PlayerState state = PlayerState.STOPPED;

    boolean shuffle = false; // Shuffle disabled initially
    boolean repeat = false; // Repeat disabled initially

    Random random = new Random(); // Random song selection

    // Load a playlist into the player
    void loadPlaylist(Playlist playlist) {

        this.playlist = playlist; // Store selected playlist
        currentIndex = 0; // Start from first song
        state = PlayerState.STOPPED; // Reset playback
    }

    // Start or resume playback
    void play() {

        // Check whether playlist has songs
        if (playlist == null || playlist.songs.isEmpty()) {
            System.out.println("No songs available");
            return;
        }

        // Change player state
        state = PlayerState.PLAYING;

        // Display current song
        showCurrentSong();
    }

    // Pause currently playing song
    void pause() {

        // Pause only if music is playing
        if (state == PlayerState.PLAYING) {
            state = PlayerState.PAUSED; // Update state
            System.out.println("Music paused");
        }
    }

    // Play next song
    void next() {

        // Handle missing or empty playlist
        if (playlist == null || playlist.songs.isEmpty()) {
            System.out.println("No songs available");
            return;
        }

        // Get total number of songs
        int size = playlist.songs.size();

        if (shuffle && size > 1) {

            // Select a different random song
            int nextIndex;

            do {
                nextIndex = random.nextInt(size);
            } while (nextIndex == currentIndex);

            currentIndex = nextIndex; // Update current song

        } else if (currentIndex < size - 1) {

            currentIndex++; // Move to next song

        } else if (repeat) {

            currentIndex = 0; // Restart playlist

        } else {

            state = PlayerState.STOPPED; // End playback
            System.out.println("Playlist finished");
            return;
        }

        play(); // Start selected song
    }

    // Play previous song
    void previous() {

        // Handle missing or empty playlist
        if (playlist == null || playlist.songs.isEmpty()) {
            System.out.println("No songs available");
            return;
        }

        // Move backward if possible
        if (currentIndex > 0) {
            currentIndex--; // Previous song
        } else if (repeat) {
            currentIndex = playlist.songs.size() - 1;
        }

        play(); // Play selected song
    }

    // Enable or disable shuffle
    void setShuffle(boolean value) {
        shuffle = value; // Update shuffle mode
    }

    // Enable or disable repeat
    void setRepeat(boolean value) {
        repeat = value; // Update repeat mode
    }

    // Display current song details
    void showCurrentSong() {

        // Ensure playlist exists
        if (playlist == null || playlist.songs.isEmpty()) {
            System.out.println("No song selected");
            return;
        }

        // Get currently selected song
        Song song = playlist.songs.get(currentIndex);

        // Display song and playback state
        System.out.println(
                state + ": " + song.title +
                " - " + song.artist);
    }
}

// Main class for demonstration
public class Main {

    public static void main(String[] args) {

        // Create songs
        Song s1 = new Song(1, "Shape of You", "Ed Sheeran", 240);
        Song s2 = new Song(2, "Believer", "Imagine Dragons", 210);
        Song s3 = new Song(3, "Perfect", "Ed Sheeran", 260);

        // Create music library
        MusicLibrary library = new MusicLibrary();

        // Add songs to library
        library.addSong(s1);
        library.addSong(s2);
        library.addSong(s3);

        // Search for a song
        System.out.println("Search results:");

        // Display matching songs
        for (Song song : library.search("Perfect")) {
            System.out.println(song.title);
        }

        // Create playlist
        Playlist playlist = new Playlist("My Favorites");

        // Add songs to playlist
        playlist.addSong(s1);
        playlist.addSong(s2);
        playlist.addSong(s3);

        // Create music player
        MusicPlayer player = new MusicPlayer();

        // Load playlist
        player.loadPlaylist(playlist);

        // Play first song
        player.play();

        // Pause playback
        player.pause();

        // Resume playback
        player.play();

        // Play next song
        player.next();

        // Play previous song
        player.previous();

        // Enable repeat
        player.setRepeat(true);

        // Enable shuffle
        player.setShuffle(true);

        // Play random next song
        player.next();
    }
}
